{
  "name": "telnyx-webdriverio-tests",
  "version": "1.0.0",
  "description": "Telnyx end-to-end tests built with WebdriverIO",
  "scripts": {
    "test": "npm run test:headless",
    "test:all": "cross-env HEADLESS=true TEST_ENV=production wdio run ./config/wdio.chrome.conf.js",
    "test:headless": "cross-env HEADLESS=true TEST_ENV=production wdio run ./config/wdio.chrome.conf.js",
    "test:headed": "cross-env HEADLESS=false TEST_ENV=production wdio run ./config/wdio.chrome.conf.js",
    "test:file": "cross-env HEADLESS=true TEST_ENV=production wdio run ./config/wdio.chrome.conf.js",
    "test:chrome": "cross-env HEADLESS=true TEST_ENV=production wdio run ./config/wdio.chrome.conf.js",
    "test:firefox": "cross-env HEADLESS=true TEST_ENV=production wdio run ./config/wdio.firefox.conf.js",
    "test:edge": "cross-env HEADLESS=true TEST_ENV=production wdio run ./config/wdio.edge.conf.js",
    "test:all:browsers": "npm run test:chrome && npm run test:firefox && npm run test:edge",
    "test:staging": "cross-env HEADLESS=true TEST_ENV=staging wdio run ./config/wdio.chrome.conf.js",
    "test:staging:firefox": "cross-env HEADLESS=true TEST_ENV=staging wdio run ./config/wdio.firefox.conf.js",
    "test:staging:edge": "cross-env HEADLESS=true TEST_ENV=staging wdio run ./config/wdio.edge.conf.js",
    "test:docker": "cross-env HEADLESS=true wdio run ./config/wdio.docker.conf.js",
    "docker:build": "docker compose build",
    "docker:test": "docker compose up --build --abort-on-container-exit --exit-code-from tests",
    "docker:stop": "docker compose stop",
    "docker:start": "docker compose start",
    "docker:down": "docker compose down --volumes --remove-orphans",
    "allure:generate": "allure generate allure-results --clean -o allure-report",
    "allure:open": "allure open allure-report",
    "allure:serve": "allure serve allure-results",
    "allure:report": "npm run allure:generate && npm run allure:open"
  },
  "keywords": [
    "webdriverio",
    "e2e",
    "telnyx",
    "allure"
  ],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@wdio/allure-reporter": "^9.30.0",
    "@wdio/cli": "^9.30.0",
    "@wdio/local-runner": "^9.30.0",
    "@wdio/mocha-framework": "^9.30.0",
    "@wdio/spec-reporter": "^9.29.1",
    "allure-commandline": "^2.43.0",
    "cross-env": "^10.1.0"
  }
}
